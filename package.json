{
  "name": "complimentr",
  "version": "1.0.5",
  "type": "module",
  "description": "Compliment and happiness generator",
  "author": "Alexfiftysix",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "required": "dist/cjs/index.js",
      "import": "dist/esm/index.mjs"
    }
  },
  "diles": [
    "dist"
  ],
  "scripts": {
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && npm run rename:esm",
    "build": "npm run build:cjs && npm run build:esm",
    "clean": "rimraf dist",
    "rename:esm": "zsh ./scripts/fix-mjs.sh",
    "prepack": "npm run clean && npm run build",
    "prepublish": "npm run build",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "private": false,
  "keywords": [
    "compliments",
    "positivity",
    "fun",
    "happiness",
    "joy",
    "timesheets",
    "procgen"
  ],
  "license": "LGPL-3.0-only",
  "repository": "https://github.com/alexfiftysix/complimentr"
}
